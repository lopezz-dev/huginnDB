# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/
# Staged sidecar binaries (see release.yml) — build output, not source.
src-tauri/binaries/

# Packaged MCP Bundles (see scripts/build-mcpb.sh) — build output. The manifest
# and the bundle's own README next to it ARE source and stay tracked.
mcpb/build/
# Cargo.lock IS committed: this is an application binary, not a library, so a
# pinned lockfile gives reproducible release builds. It was previously ignored,
# which let CI resolve dependencies fresh on every run and drift onto a broken
# transitive version (a brotli/alloc-no-stdlib mismatch that failed the 1.1.0
# release build). Keep it tracked.

# OS
Thumbs.db
sample-data

# Local env
.env
.env.local

# Claude Code local settings. Everything under .claude/ stays local except
# the project skills, which are shared tooling (e.g. skills/release).
.claude/*
!.claude/skills/
